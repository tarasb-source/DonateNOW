{
  "name": "donatenow",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev -w client\" \"cd server-java && ./mvnw spring-boot:run\"",
    "build": "npm run build -w client",
    "lint": "npm run lint -w client",
    "deploy": "npm run deploy -w client"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
