{
  "name": "donatenow",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"npm run dev -w frontend\" \"cd backend && ./mvnw spring-boot:run\"",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend",
    "deploy": "npm run deploy -w frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
