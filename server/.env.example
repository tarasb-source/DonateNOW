
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Max database connections per server instance (use 2-3 on Vercel)
DATABASE_POOL_MAX=5

PORT=3000

# Comma-separated origins allowed to call the API
CLIENT_ORIGINS="http://localhost:5173"

# https://gnews.io - rotate the old key that was committed to git
GNEWS_API_KEY=""

# Where donors return after donating (no trailing slash)
PUBLIC_SITE_URL="http://localhost:5173/DonateNOW"

# Every.org donations. Use https://staging.every.org to test with card 4242 4242 4242 4242.
EVERYORG_BASE_URL="https://www.every.org"
# Every.org developer dashboard -> Partner Webhook token
EVERYORG_WEBHOOK_TOKEN=""
# Long random string; the webhook URL to register is <API URL>/api/donations/webhook/<this secret>
# Generate one with: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
DONATION_WEBHOOK_SECRET=""

# https://serpapi.com (free plan: 250 searches/month) - weekly event import
SERPAPI_KEY=""

# Every.org developer dashboard -> public API key (pk_live_...); used to verify charity slugs
EVERYORG_API_KEY=""
