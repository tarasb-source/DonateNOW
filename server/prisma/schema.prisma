generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Opportunity {
  id           Int      @id @default(autoincrement())
  title        String
  organization String
  location     String
  category     String
  tags         String
  description  String   @default("")
  link         String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  message    String
  newsletter Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Event {
  id           Int       @id @default(autoincrement())
  title        String
  organization String
  description  String    @default("")
  category     String    @default("")
  link         String    @default("")
  startsAt     DateTime  @db.Timestamptz(3)
  endsAt       DateTime? @db.Timestamptz(3)
  // Human-readable place, plus coordinates for the map and distance search.
  address      String    @default("")
  city         String
  country      String
  latitude     Float
  longitude    Float
  // Only APPROVED events are shown on the site. Imported events start as PENDING.
  status       EventStatus @default(APPROVED)
  // Where the event came from ("manual", "google") and that source's ID, to avoid re-importing.
  source       String    @default("manual")
  sourceId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([source, sourceId])
  @@index([status, startsAt])
  @@index([latitude, longitude])
}

// A visitor clicked "Donate" on our site; its id is sent to Every.org as partner_donation_id.
model DonationIntent {
  id            String             @id @default(uuid())
  nonprofitSlug String
  // Suggested amount in cents; the donor can still change it on Every.org.
  amountCents   Int?
  frequency     DonationFrequency
  createdAt     DateTime           @default(now())
  donations     Donation[]
}

// A completed charge reported by Every.org's webhook. Monthly donations produce one per month.
model Donation {
  id             Int               @id @default(autoincrement())
  chargeId       String            @unique
  intent         DonationIntent    @relation(fields: [intentId], references: [id])
  intentId       String
  nonprofitSlug  String
  nonprofitName  String
  amountCents    Int
  netAmountCents Int?
  currency       String
  frequency      DonationFrequency
  donatedAt      DateTime          @db.Timestamptz(3)
  createdAt      DateTime          @default(now())

  @@index([intentId])
}

enum DonationFrequency {
  ONCE
  MONTHLY
}
