generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Opportunity {
  id           Int      @id @default(autoincrement())
  title        String
  organization String
  location     String
  category     String
  tags         String
  description  String   @default("")
  link         String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  message    String
  newsletter Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Event {
  id           Int       @id @default(autoincrement())
  title        String
  organization String
  description  String    @default("")
  category     String    @default("")
  link         String    @default("")
  startsAt     DateTime  @db.Timestamptz(3)
  endsAt       DateTime? @db.Timestamptz(3)
  // Human-readable place, plus coordinates for the map and distance search.
  address      String    @default("")
  city         String
  country      String
  latitude     Float
  longitude    Float
  // Only APPROVED events are shown on the site. Imported events start as PENDING.
  status       EventStatus @default(APPROVED)
  // Where the event came from ("manual", "google") and that source's ID, to avoid re-importing.
  source       String    @default("manual")
  sourceId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([source, sourceId])
  @@index([status, startsAt])
  @@index([latitude, longitude])
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}
